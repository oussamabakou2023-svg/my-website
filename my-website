            const percentage = Math.round((doneCount / totalTasks) * 100);

            document.getElementById('tasks-percentage').textContent = `${percentage}% (${doneCount}/${totalTasks})`;
            document.getElementById('tasks-progress-bar').style.width = `${percentage}%`;

            const unlockBtn = document.getElementById('btn-unlock-voucher');
            if (doneCount === totalTasks) {
                unlockBtn.disabled = false;
                unlockBtn.className = 'w-full py-4 px-6 rounded-2xl bg-gradient-to-l from-emerald-600 to-amber-500 hover:from-emerald-500 hover:to-amber-400 text-slate-950 font-black flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/25 transition-all cursor-pointer active:scale-[0.99]';
                unlockBtn.innerHTML = '<i data-lucide="unlock" class="w-5 h-5"></i><span>فتح القسيمة الآن</span>';
            } else {
                unlockBtn.disabled = true;
                unlockBtn.className = 'w-full py-4 px-6 rounded-2xl bg-slate-800 text-slate-500 font-bold flex items-center justify-center gap-2 transition-all cursor-not-allowed';
                unlockBtn.innerHTML = '<i data-lucide="lock" class="w-5 h-5"></i><span>أكمل المهام لفتح القسيمة</span>';
            }
            lucide.createIcons();
        }

        // الانتقال إلى الخطوة الثالثة وكشف القسيمة
        function revealVoucher() {
            if (isKickedOut) return;
            const doneCount = Object.values(completedTasks).filter(Boolean).length;
            if (doneCount < 3) return;

            // صرف قسيمة واحدة فقط من القائمة المحددة وإنقاص العدد في كل مرة تُستعمل فيها
            if (!currentAssignedVoucher) {
                const nextIndex = VOUCHER_POOL.findIndex((_, idx) => !issuedVoucherIndexes.has(idx));
                if (nextIndex !== -1) {
                    issuedVoucherIndexes.add(nextIndex);
                    currentAssignedVoucher = VOUCHER_POOL[nextIndex];
                } else {
                    currentAssignedVoucher = 'نفدت جميع القسائم (0/30)';
                }
            }

            document.getElementById('voucher-code').textContent = currentAssignedVoucher;
            updateVoucherCountDisplay();

            goToStep(3);
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 90,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        }

        // نسخ رمز الدعوة 79UJ
        function copyInviteCode(btn) {
            copyTextToClipboard('79UJ', 'تم نسخ رمز الدعوة 79UJ بنجاح!');
            if (btn) {
                const span = btn.querySelector('span');
                if (span) {
                    const original = span.textContent;
                    span.textContent = 'تم النسخ!';
                    setTimeout(() => {
                        span.textContent = original;
                    }, 1800);
                }
            }
        }

        // نسخ كود القسيمة النهائي
        function copyVoucherCode() {
            const codeEl = document.getElementById('voucher-code');
            const textBtn = document.getElementById('copy-btn-text');
            if (!codeEl) return;

            copyTextToClipboard(codeEl.textContent.trim(), 'تم نسخ كود القسيمة بنجاح!');
            if (textBtn) {
                const prev = textBtn.textContent;
                textBtn.textContent = 'تم النسخ!';
                setTimeout(() => {
                    textBtn.textContent = prev;
                }, 1800);
            }
        }

        // نسخ نص إلى الحافظة بشكل متوافق مع iFrame
        function copyTextToClipboard(text, toastMsg) {
            try {
                const tempInput = document.createElement('textarea');
                tempInput.value = text;
                tempInput.setAttribute('readonly', '');
                tempInput.style.position = 'absolute';
                tempInput.style.left = '-9999px';
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                showToast(toastMsg);
            } catch (err) {
                showToast('تعذر النسخ تلقائياً، يرجى النسخ يدوياً.');
            }
        }

        // إظهار إشعار Toast منبثق
        function showToast(message) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            if (!toast || !msgEl) return;

            msgEl.textContent = message;
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(window.__toastTimer);
            window.__toastTimer = setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2800);
        }

        // التنقل بين الخطوات وتحديث شريط التتبع العلوي
        function goToStep(step) {
            if (isKickedOut) return;
            currentStep = step;

            // إخفاء جميع المحتويات
            document.getElementById('step-1-content').classList.add('hidden');
            document.getElementById('step-2-content').classList.add('hidden');
            document.getElementById('step-3-content').classList.add('hidden');
            document.getElementById('kicked-out-content').classList.add('hidden');

            // إظهار المحتوى الحالي
            document.getElementById(`step-${step}-content`).classList.remove('hidden');

            // تحديث شريط التقدم العلوي
            const progressLine = document.getElementById('progress-line');
            const step1Ind = document.getElementById('step-indicator-1');
            const step2Ind = document.getElementById('step-indicator-2');
            const step3Ind = document.getElementById('step-indicator-3');
            const step1Lbl = document.getElementById('step-label-1');
            const step2Lbl = document.getElementById('step-label-2');
            const step3Lbl = document.getElementById('step-label-3');

            step1Ind.innerHTML = '<i data-lucide="user-check" class="w-5 h-5"></i>';
            step2Ind.innerHTML = '<i data-lucide="list-checks" class="w-5 h-5"></i>';
            step3Ind.innerHTML = '<i data-lucide="gift" class="w-5 h-5"></i>';

            if (step === 1) {
                progressLine.style.width = '0%';
                step1Ind.className = 'w-11 h-11 rounded-2xl bg-red-600 text-white font-bold flex items-center justify-center shadow-lg shadow-red-600/40 border-2 border-red-400 transition-all duration-300';
                step2Ind.className = 'w-11 h-11 rounded-2xl bg-gaming-card text-slate-500 font-bold flex items-center justify-center border-2 border-gaming-border transition-all duration-300';
                step3Ind.className = 'w-11 h-11 rounded-2xl bg-gaming-card text-slate-500 font-bold flex items-center justify-center border-2 border-gaming-border transition-all duration-300';
                step1Lbl.className = 'text-xs sm:text-sm font-bold text-white';
                step2Lbl.className = 'text-xs sm:text-sm font-semibold text-slate-500';
                step3Lbl.className = 'text-xs sm:text-sm font-semibold text-slate-500';
            } else if (step === 2) {
                progressLine.style.width = '50%';
                step1Ind.className = 'w-11 h-11 rounded-2xl bg-emerald-600 text-white font-bold flex items-center justify-center shadow-lg shadow-emerald-600/30 border-2 border-emerald-400 transition-all duration-300';
                step2Ind.className = 'w-11 h-11 rounded-2xl bg-red-600 text-white font-bold flex items-center justify-center shadow-lg shadow-red-600/40 border-2 border-red-400 transition-all duration-300';
                step3Ind.className = 'w-11 h-11 rounded-2xl bg-gaming-card text-slate-500 font-bold flex items-center justify-center border-2 border-gaming-border transition-all duration-300';
                step1Lbl.className = 'text-xs sm:text-sm font-bold text-emerald-400';
                step2Lbl.className = 'text-xs sm:text-sm font-bold text-white';
                step3Lbl.className = 'text-xs sm:text-sm font-semibold text-slate-500';
            } else if (step === 3) {
                progressLine.style.width = '100%';
                step1Ind.className = 'w-11 h-11 rounded-2xl bg-emerald-600 text-white font-bold flex items-center justify-center border-2 border-emerald-400 transition-all duration-300';
                step2Ind.className = 'w-11 h-11 rounded-2xl bg-emerald-600 text-white font-bold flex items-center justify-center border-2 border-emerald-400 transition-all duration-300';
                step3Ind.className = 'w-11 h-11 rounded-2xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shadow-lg shadow-amber-500/40 border-2 border-amber-300 transition-all duration-300';
                step1Lbl.className = 'text-xs sm:text-sm font-bold text-emerald-400';
                step2Lbl.className = 'text-xs sm:text-sm font-bold text-emerald-400';
                step3Lbl.className = 'text-xs sm:text-sm font-black text-amber-400';
            }

            lucide.createIcons();
        }

        // إعادة ضبط التجربة بالكامل
        function resetFlow() {
            isKickedOut = false;
            currentAssignedVoucher = null;
            failedVerificationAttempts = 0;
            updateAttemptsBadge();

            completedTasks = { 1: false, 2: false, 3: false };
            currentScreenshotFile = null;
            isAnalyzingScreenshot = false;
            document.getElementById('player-id').value = '';

            // إعادة ضبط حقل لقطة الشاشة الخاص بالمهمة الأولى
            const screenshotInput = document.getElementById('screenshot-input');
            if (screenshotInput) screenshotInput.value = '';
            if (uploadedScreenshotUrl) {
                URL.revokeObjectURL(uploadedScreenshotUrl);
                uploadedScreenshotUrl = null;
            }
            document.getElementById('screenshot-preview-box').classList.add('hidden');
            document.getElementById('screenshot-dropzone').classList.remove('hidden');
            document.getElementById('screenshot-error').classList.add('hidden');
            document.getElementById('ocr-feedback-box').classList.add('hidden');
            document.getElementById('ocr-extracted-wrapper').classList.add('hidden');
            document.getElementById('ocr-enforcement-actions').classList.add('hidden');

            const badge = document.getElementById('screenshot-status-badge');
            badge.textContent = 'بانتظار رفع الصورة';
            badge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-gaming-border';

            // إعادة ضبط بطاقات المهام
            const card1 = document.getElementById('task-card-1');
            card1.className = 'bg-gaming-dark/90 border border-gaming-border rounded-2xl p-4 sm:p-5 transition-all';

            const taskIcons = ['send', 'check'];
            const taskLabels = ['إتمام الخطوة', 'تحقق الآن'];
            const hoverColors = ['hover:bg-sky-600', 'hover:bg-emerald-600'];

            for (let i = 2; i <= 3; i++) {
                const card = document.getElementById(`task-card-${i}`);
                const btn = document.getElementById(`task-btn-${i}`);

                card.className = 'bg-gaming-dark/90 border border-gaming-border rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition-all';
                btn.disabled = false;
                btn.className = `w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-800 ${hoverColors[i-2]} text-white text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 shrink-0 cursor-pointer`;
                btn.innerHTML = `<span>${taskLabels[i-2]}</span><i data-lucide="${taskIcons[i-2]}" class="w-4 h-4"></i>`;
            }

            // إعادة ضبط شريط التقدم وزر الفتح
            document.getElementById('tasks-percentage').textContent = '0% (0/3)';
            document.getElementById('tasks-progress-bar').style.width = '0%';
            updateVoucherCountDisplay();

            const unlockBtn = document.getElementById('btn-unlock-voucher');
            unlockBtn.disabled = true;
            unlockBtn.className = 'w-full py-4 px-6 rounded-2xl bg-slate-800 text-slate-500 font-bold flex items-center justify-center gap-2 transition-all cursor-not-allowed';
            unlockBtn.innerHTML = `<i data-lucide="lock" class="w-5 h-5"></i><span>أكمل المهام لفتح القسيمة</span>`;

            goToStep(1);
        }

        // تهيئة عداد القسائم عند تحميل الصفحة
        updateVoucherCountDisplay();
    </script>
</body>
</html>

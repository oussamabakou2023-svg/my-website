        // تطبيع النص المستخرج للبحث الصارم عن رمز الدعوة 79UJ
        function normalizeOcrForCode(rawText) {
            if (!rawText || typeof rawText !== 'string') return '';
            const arabicDigits = '٠١٢٣٤٥٦٧٨٩';
            const converted = rawText.replace(/[٠-٩]/g, d => String(arabicDigits.indexOf(d))).toUpperCase();
            return converted.replace(/[^A-Z0-9]/g, '');
        }

        // فحص صارم لوجود رمز الدعوة 79UJ ورصد مؤشرات الدقائق/المكافأة بعد إدخال الرمز
        function evaluateInviteCodePresence(rawText) {
            const cleanedRaw = (rawText || '').trim();
            const compactUpper = (rawText || '').toUpperCase().replace(/\s+/g, '');
            const normalizedAlphaNum = normalizeOcrForCode(rawText);

            // تطابق صارم مع الرمز 79UJ (مع السماح بفراغات بين أحرفه فقط)
            const directCodeFound = /\b7\s*9\s*U\s*J\b/i.test(cleanedRaw) ||
                compactUpper.includes('79UJ') ||
                normalizedAlphaNum.includes('79UJ');

            // رصد مؤشرات الدقائق أو المكافآت المرتبطة بإدخال الرمز
            const hasMinutesOrReward = /(دقائق|دقيقة|دقايق|minutes?|mins?|points?|نقاط|مكافأة|مكافاه|reward|bonus)/i.test(cleanedRaw);

            return {
                found: directCodeFound,
                hasMinutesOrReward,
                hasAnyText: cleanedRaw.length > 0
            };
        }


<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بوابة مكافآت وقسائم جارينا - واجهة تجريبية</title>
    <!-- استدعاء خطوط Google العربية (Cairo & Tajawal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- مكتبة Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- مكتبة أيقونات Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- مكتبة Confetti للاحتفال عند استلام الكود -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- مكتبة Tesseract.js للتعرف البصري على النصوص (OCR) داخل المتصفح -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                        tajawal: ['Tajawal', 'sans-serif'],
                    },
                    colors: {
                        gaming: {
                            dark: '#090b10',
                            card: '#111622',
                            border: '#1e2738',
                            neon: '#ff3b30', // أحمر جارينا النيون
                            accent: '#f59e0b', // ذهبي الجواهر
                            cyan: '#00f0ff',
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                    },
                    keyframes: {
                        glow: {
                            '0%': { boxShadow: '0 0 10px rgba(255, 59, 48, 0.3)' },
                            '100%': { boxShadow: '0 0 25px rgba(255, 59, 48, 0.7)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #090b10;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(255, 59, 48, 0.08), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(245, 158, 11, 0.08), transparent 25%);
            color: #f8fafc;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(17, 22, 34, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .step-connector {
            transition: all 0.5s ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-red-500 selection:text-white">

    <!-- شريط تنبيه علوي يوضح أن الواجهة للمحاكاة فقط -->
    <div class="bg-gradient-to-l from-red-600/20 via-amber-500/20 to-red-600/20 border-b border-red-500/30 py-2 px-4 text-center text-xs sm:text-sm font-tajawal text-amber-300 flex items-center justify-center gap-2">
        <i data-lucide="info" class="w-4 h-4 text-amber-400 shrink-0"></i>
        <span>واجهة عرض تفاعلية (Demo Template) - لا يُطلب إدخال أي كلمات مرور أو بيانات حساسة.</span>
    </div>

    <!-- الهيدر (Header) -->
    <header class="w-full max-w-5xl mx-auto px-4 pt-6 pb-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-red-600 to-amber-500 p-0.5 shadow-lg shadow-red-600/20">
                <div class="w-full h-full bg-gaming-card rounded-[14px] flex items-center justify-center">
                    <i data-lucide="gamepad-2" class="w-7 h-7 text-red-500"></i>
                </div>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-black tracking-wide bg-gradient-to-l from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                    مركز قسائم جارينا
                </h1>
                <p class="text-xs text-slate-400 font-tajawal">نظام استرداد المكافآت الفوري</p>
            </div>
        </div>

        <!-- شارة الحالة -->
        <div class="flex items-center gap-2 bg-gaming-card border border-gaming-border px-3.5 py-2 rounded-full text-xs sm:text-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 -mr-4.5"></span>
            <span class="text-slate-300 font-semibold mr-2">حالة الخادم: نشط</span>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="w-full max-w-3xl mx-auto px-4 py-6 flex-grow flex flex-col justify-center">
        
        <!-- بطاقة عرض القسيمة المستهدفة -->
        <div class="glass-panel rounded-3xl p-5 sm:p-6 mb-8 relative overflow-hidden border border-amber-500/20 shadow-2xl">
            <div class="absolute -left-10 -top-10 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl"></div>
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 relative z-10">
                <div class="flex items-center gap-4 text-center sm:text-right flex-col sm:flex-row">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400/20 to-red-500/20 border border-amber-500/30 flex items-center justify-center shrink-0">
                        <i data-lucide="gem" class="w-8 h-8 text-amber-400"></i>
                    </div>
                    <div>
                        <span class="inline-block px-2.5 py-0.5 rounded-md bg-red-500/20 text-red-400 text-xs font-bold mb-1">
                            مكافأة موسمية متاحة
                        </span>
                        <h2 class="text-lg sm:text-xl font-bold text-white">قسيمة شحن 530 جوهرة + مكافأة إضافية</h2>
                        <p class="text-xs sm:text-sm text-slate-400 font-tajawal mt-0.5">أكمل الخطوات الثلاث بالأسفل لفتح كود القسيمة الخاص بك</p>
                    </div>
                </div>
                <div class="bg-gaming-dark/80 border border-gaming-border rounded-2xl px-4 py-2.5 text-center shrink-0 w-full sm:w-auto">
                    <span class="block text-[11px] text-slate-400">عدد القسائم المتبقية</span>
                    <span class="text-lg font-black text-amber-400 font-mono" id="remaining-vouchers">30 قسيمة</span>
                </div>
            </div>
        </div>

        <!-- شريط تتبع الخطوات (Progress Tracker) -->
        <div class="mb-8 px-2">
            <div class="flex items-center justify-between relative">
                <!-- الخط الخلفي -->
                <div class="absolute top-1/2 left-0 right-0 h-1 bg-gaming-border -translate-y-1/2 rounded-full z-0"></div>
                <!-- الخط الملون للتقدم -->
                <div id="progress-line" class="absolute top-1/2 right-0 h-1 bg-gradient-to-l from-red-500 to-amber-500 -translate-y-1/2 rounded-full z-0 transition-all duration-500" style="width: 0%;"></div>

                <!-- الخطوة 1 -->
                <div class="relative z-10 flex flex-col items-center gap-2">
                    <div id="step-indicator-1" class="w-11 h-11 rounded-2xl bg-red-600 text-white font-bold flex items-center justify-center shadow-lg shadow-red-600/40 border-2 border-red-400 transition-all duration-300">
                        <i data-lucide="user-check" class="w-5 h-5"></i>
                    </div>
                    <span id="step-label-1" class="text-xs sm:text-sm font-bold text-white">1. بيانات اللاعب</span>
                </div>

                <!-- الخطوة 2 -->
                <div class="relative z-10 flex flex-col items-center gap-2">
                    <div id="step-indicator-2" class="w-11 h-11 rounded-2xl bg-gaming-card text-slate-500 font-bold flex items-center justify-center border-2 border-gaming-border transition-all duration-300">
                        <i data-lucide="list-checks" class="w-5 h-5"></i>
                    </div>
                    <span id="step-label-2" class="text-xs sm:text-sm font-semibold text-slate-500">2. إتمام المهام</span>
                </div>

                <!-- الخطوة 3 -->
                <div class="relative z-10 flex flex-col items-center gap-2">
                    <div id="step-indicator-3" class="w-11 h-11 rounded-2xl bg-gaming-card text-slate-500 font-bold flex items-center justify-center border-2 border-gaming-border transition-all duration-300">
                        <i data-lucide="gift" class="w-5 h-5"></i>
                    </div>
                    <span id="step-label-3" class="text-xs sm:text-sm font-semibold text-slate-500">3. استلام القسيمة</span>
                </div>
            </div>
        </div>

        <!-- حاوية الخطوات التفاعلية -->
        <div class="glass-panel rounded-3xl p-6 sm:p-8 shadow-2xl border border-gaming-border relative">
            
            <!-- ==================== الخطوة الأولى: إدخال معرف اللاعب ==================== -->
            <div id="step-1-content" class="transition-all duration-300">
                <div class="flex items-center gap-3 mb-4">
                    <span class="w-8 h-8 rounded-lg bg-red-500/20 text-red-400 flex items-center justify-center font-bold">1</span>
                    <h3 class="text-xl font-bold text-white">تحديد حساب اللاعب (محاكاة)</h3>
                </div>
                <p class="text-slate-400 text-sm font-tajawal mb-6 leading-relaxed">
                    أدخل معرف اللاعب (Player ID) الخاص بك لتجهيز القسيمة. <strong class="text-amber-400">ملاحظة:</strong> هذا الحقل للمحاكاة فقط، لا تقم أبداً بإدخال كلمة مرور حسابك في أي موقع.
                </p>

                <div class="space-y-4">
                    <div>
                        <label for="player-id" class="block text-sm font-bold text-slate-300 mb-2">معرف اللاعب (Player ID)</label>
                        <div class="relative">
                            <input type="text" id="player-id" placeholder="مثال: 1234567890" maxlength="15"
                                class="w-full bg-gaming-dark border border-gaming-border focus:border-red-500 rounded-2xl px-4 py-3.5 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-red-500/20 transition-all text-left dir-ltr font-mono text-lg">
                            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-500">
                                <i data-lucide="hash" class="w-5 h-5"></i>
                            </div>
                        </div>
                        <p id="id-error" class="text-red-400 text-xs mt-2 hidden flex items-center gap-1">
                            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                            <span>يرجى إدخال معرف لاعب صحيح (أرقام فقط من 5 إلى 15 خانة).</span>
                        </p>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-300 mb-2">اختر الخادم (Server)</label>
                        <div class="grid grid-cols-3 gap-3">
                            <button type="button" onclick="selectServer(this, 'الشرق الأوسط')" class="server-btn active bg-red-600/20 border-2 border-red-500 text-white rounded-xl py-2.5 px-3 text-xs sm:text-sm font-bold transition-all">
                                الشرق الأوسط
                            </button>
                            <button type="button" onclick="selectServer(this, 'أوروبا')" class="server-btn bg-gaming-dark border border-gaming-border text-slate-400 hover:border-slate-600 rounded-xl py-2.5 px-3 text-xs sm:text-sm font-bold transition-all">
                                أوروبا
                            </button>
                            <button type="button" onclick="selectServer(this, 'عالمي')" class="server-btn bg-gaming-dark border border-gaming-border text-slate-400 hover:border-slate-600 rounded-xl py-2.5 px-3 text-xs sm:text-sm font-bold transition-all">
                                عالمي
                            </button>
                        </div>
                    </div>

                    <button id="btn-step-1" onclick="verifyPlayerId()" class="w-full mt-4 bg-gradient-to-l from-red-600 to-red-500 hover:from-red-500 hover:to-red-400 text-white font-bold py-4 px-6 rounded-2xl shadow-lg shadow-red-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]">
                        <span>التحقق من المعرف والمتابعة</span>
                        <i data-lucide="arrow-left" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <!-- ==================== الخطوة الثانية: إتمام المهام ==================== -->
            <div id="step-2-content" class="hidden transition-all duration-300">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-4 border-b border-gaming-border">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold">2</span>
                        <div>
                            <h3 class="text-lg sm:text-xl font-bold text-white">إتمام مهام التحقق</h3>
                            <p class="text-xs text-slate-400">أكمل جميع المهام الثلاث لفتح قفل القسيمة</p>
                        </div>
                    </div>
                    <!-- شارة اللاعب المتحقق منه -->
                    <div class="bg-gaming-dark border border-emerald-500/30 rounded-xl px-3 py-1.5 flex items-center gap-2 text-xs">
                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
                        <span class="text-slate-300">ID: <strong id="display-player-id" class="text-white font-mono">---</strong></span>
                        <span class="text-slate-500">|</span>
                        <span id="display-server" class="text-amber-400 font-bold">الشرق الأوسط</span>
                    </div>
                </div>

                <!-- قائمة المهام -->
                <div class="space-y-3.5 my-6">
                    <!-- مهمة 1 -->
                    <div id="task-card-1" class="bg-gaming-dark/90 border border-gaming-border rounded-2xl p-4 sm:p-5 transition-all">
                        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
                            <div class="flex items-start sm:items-center gap-3.5">
                                <div class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0 mt-1 sm:mt-0">
                                    <i data-lucide="smartphone" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h4 class="font-bold text-white text-sm sm:text-base">تحميل تطبيق CafeGo وإدخال رمز الدعوة 79UJ</h4>
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-500/15 text-red-300 border border-red-500/30">تحقق صارم</span>
                                    </div>
                                    <p class="text-xs text-slate-400 font-tajawal mt-1 leading-relaxed">
                                        1. حمّل تطبيق <strong class="text-slate-200">CafeGo</strong> من متجر Google Play.<br>
                                        2. أدخل رمز الدعوة الخاص بي: <span class="text-amber-400 font-mono font-black tracking-wider bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/30">79UJ</span> داخل التطبيق.<br>
                                        3. ارفع لقطة شاشة (Screenshot) واضحة تثبت كتابة الرمز <strong class="text-amber-300 font-mono">79UJ</strong> أو حصولك على الدقائق بعد إدخال الرمز. <strong class="text-red-400">النظام صارم: الحد الأقصى 3 محاولات فاشلة قبل الإخراج.</strong>
                                    </p>
                                </div>
                            </div>
                            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full lg:w-auto shrink-0">
                                <button type="button" onclick="copyInviteCode(this)" class="w-full sm:w-auto px-3.5 py-2.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 shrink-0 cursor-pointer active:scale-95" title="نسخ رمز الدعوة 79UJ">
                                    <i data-lucide="copy" class="w-4 h-4"></i>
                                    <span>نسخ الرمز: 79UJ</span>
                                </button>
                                <a id="task-link-1" href="https://play.google.com/store/apps/details?id=com.cafego.android&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" onclick="handleDownloadClick()" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 shrink-0 cursor-pointer shadow-md shadow-amber-600/20">
                                    <span>تحميل التطبيق</span>
                                    <i data-lucide="download" class="w-4 h-4"></i>
                                </a>
                            </div>
                        </div>

                        <!-- منطقة رفع لقطة الشاشة (Screenshot) لإثبات إدخال رمز الدعوة 79UJ أو الدقائق -->
                        <div class="mt-4 pt-4 border-t border-gaming-border/80">
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                                <label for="screenshot-input" class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                                    <i data-lucide="image-plus" class="w-4 h-4 text-amber-400"></i>
                                    <span>إرفاق لقطة شاشة (Screenshot) لإثبات الرمز 79UJ أو الدقائق</span>
                                </label>
                                <div class="flex items-center gap-2">
                                    <span id="failed-attempts-badge" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-red-500/10 text-red-300 border border-red-500/30 font-mono">
                                        المخالفات: 0 / 3
                                    </span>
                                    <span id="screenshot-status-badge" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-gaming-border">
                                        بانتظار رفع الصورة
                                    </span>
                                </div>
                            </div>

                            <!-- حقل الإدخال المخفي للملفات -->
                            <input type="file" id="screenshot-input" accept="image/*" class="hidden" onchange="handleScreenshotInputChange(event)">

                            <!-- منطقة السحب والإفلات أو النقر لاختيار صورة -->
                            <div id="screenshot-dropzone"
                                onclick="document.getElementById('screenshot-input').click()"
                                ondragover="handleDragOver(event)"
                                ondragleave="handleDragLeave(event)"
                                ondrop="handleDrop(event)"
                                class="border-2 border-dashed border-gaming-border hover:border-amber-500/60 bg-gaming-dark/70 rounded-2xl p-4 text-center cursor-pointer transition-all group">
                                <div class="w-10 h-10 mx-auto mb-2 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-105 transition-transform">
                                    <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                                </div>
                                <p class="text-xs sm:text-sm font-bold text-slate-200">
                                    اسحب وأفلت لقطة الشاشة هنا أو <span class="text-amber-400 underline underline-offset-2">اختر صورة من جهازك</span>
                                </p>
                                <p class="text-[11px] text-slate-500 font-tajawal mt-1">
                                    يدعم PNG, JPG, WEBP (حد أقصى 5 ميجابايت) - فحص صارم للرمز <span class="text-amber-300 font-mono">79UJ</span> ومؤشرات الدقائق عبر OCR
                                </p>
                            </div>

                            <!-- صندوق فحص وتحليل الصورة ومعاينة النتيجة -->
                            <div id="screenshot-preview-box" class="hidden mt-3 bg-gaming-dark border border-gaming-border rounded-2xl p-3.5 space-y-3 transition-all">
                                <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                                    <div class="flex items-center gap-3 w-full sm:w-auto">
                                        <img id="screenshot-preview-img" src="" alt="معاينة لقطة الشاشة" class="w-16 h-16 rounded-xl object-cover border border-gaming-border shrink-0 bg-slate-900">
                                        <div class="min-w-0">
                                            <div id="ocr-result-headline" class="flex items-center gap-1.5 text-amber-300 text-xs font-bold">
                                                <i data-lucide="scan-search" class="w-4 h-4 shrink-0 animate-pulse"></i>
                                                <span>جاري فحص وتحليل لقطة الشاشة بصرامة...</span>
                                            </div>
                                            <p id="screenshot-file-name" class="text-xs text-slate-300 font-mono truncate mt-0.5 max-w-[200px] sm:max-w-[240px]">screenshot.png</p>
                                            <p id="screenshot-file-size" class="text-[11px] text-slate-500 font-tajawal">0 KB</p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2 w-full sm:w-auto justify-end shrink-0">
                                        <button type="button" onclick="document.getElementById('screenshot-input').click()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                                            <span>تغيير</span>
                                        </button>
                                        <button type="button" onclick="removeScreenshot()" class="px-3 py-2 rounded-xl bg-red-500/15 hover:bg-red-500/25 border border-red-500/30 text-red-400 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                            <span>إزالة</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- شريط تقدم فحص OCR -->
                                <div id="ocr-progress-wrapper" class="bg-slate-900/90 border border-gaming-border rounded-xl p-2.5">
                                    <div class="flex items-center justify-between text-[11px] font-bold mb-1.5">
                                        <span id="ocr-progress-stage" class="text-amber-300 font-tajawal">تهيئة محرك التعرف البصري (OCR)...</span>
                                        <span id="ocr-progress-percent" class="text-slate-300 font-mono">0%</span>
                                    </div>
                                    <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                                        <div id="ocr-progress-bar" class="h-full bg-gradient-to-l from-red-500 via-amber-400 to-emerald-400 transition-all duration-300 rounded-full" style="width: 0%;"></div>
                                    </div>
                                </div>


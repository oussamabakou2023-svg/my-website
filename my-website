        // تشغيل فحص OCR الفعلي على الصورة المرفوعة عبر Tesseract.js
        async function analyzeScreenshotWithOcr(fileOrUrl) {
            if (isAnalyzingScreenshot || isKickedOut) return;
            isAnalyzingScreenshot = true;

            const headlineEl = document.getElementById('ocr-result-headline');
            const progressWrapper = document.getElementById('ocr-progress-wrapper');
            const progressBar = document.getElementById('ocr-progress-bar');
            const progressPercent = document.getElementById('ocr-progress-percent');
            const progressStage = document.getElementById('ocr-progress-stage');
            const feedbackBox = document.getElementById('ocr-feedback-box');
            const enforcementActions = document.getElementById('ocr-enforcement-actions');

            headlineEl.className = 'flex items-center gap-1.5 text-amber-300 text-xs font-bold';
            headlineEl.innerHTML = `<i data-lucide="scan-search" class="w-4 h-4 shrink-0 animate-spin"></i><span>جاري فحص وتحليل لقطة الشاشة بصرامة...</span>`;

            progressWrapper.classList.remove('hidden');
            feedbackBox.classList.add('hidden');
            enforcementActions.classList.add('hidden');
            progressBar.style.width = '8%';
            progressPercent.textContent = '8%';
            progressStage.textContent = 'جاري تحميل محرك التعرف على النصوص (eng+ara)...';

            setTaskOnePendingState(
                'جاري الفحص الصارم...',
                'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40',
                false
            );
            lucide.createIcons();

            try {
                if (typeof Tesseract === 'undefined' || !Tesseract.recognize) {
                    throw new Error('محرك Tesseract.js غير متاح حالياً في المتصفح.');
                }

                const result = await Tesseract.recognize(fileOrUrl, 'eng+ara', {
                    logger: (m) => {
                        if (m && typeof m.progress === 'number') {
                            const pct = Math.min(98, Math.max(8, Math.round(m.progress * 100)));
                            progressBar.style.width = `${pct}%`;
                            progressPercent.textContent = `${pct}%`;

                            if (m.status === 'loading tesseract core' || m.status === 'initializing tesseract') {
                                progressStage.textContent = 'تهيئة نواة التعرف البصري...';
                            } else if (m.status === 'loading language traineddata') {
                                progressStage.textContent = 'تحميل حزم اللغات العربية والإنجليزية...';
                            } else if (m.status === 'recognizing text') {
                                progressStage.textContent = 'قراءة النصوص والرموز والدقائق داخل لقطة الشاشة...';
                            }
                        }
                    }
                });

                progressBar.style.width = '100%';
                progressPercent.textContent = '100%';
                progressStage.textContent = 'اكتمل التحليل البصري.';

                const extractedText = (result && result.data && result.data.text) ? result.data.text : '';
                const evaluation = evaluateInviteCodePresence(extractedText);

                if (evaluation.found) {
                    const note = evaluation.hasMinutesOrReward
                        ? 'تم التحقق الصارم بنجاح: رمز الدعوة (79UJ) ومؤشر الدقائق/المكافأة ظاهران في لقطة الشاشة.'
                        : 'تم التحقق الصارم بنجاح: تم العثور على رمز الدعوة (79UJ) في لقطة الشاشة.';
                    applyVerificationOutcome(true, extractedText, note, evaluation.hasMinutesOrReward);
                } else if (evaluation.hasAnyText) {
                    applyVerificationOutcome(
                        false,
                        extractedText,
                        'مرفوض! تمت قراءة نص من الصورة ولكن لم يتم العثور على رمز الدعوة (79UJ) أو إثبات إدخاله وحصولك على الدقائق. أعد رفع لقطة شاشة صحيحة.'
                    );
                } else {
                    applyVerificationOutcome(
                        false,
                        '',
                        'مرفوض! لم يتمكن الفحص الصارم من رصد رمز الدعوة (79UJ) في لقطة الشاشة. تأكد من كتابة الرمز 79UJ بوضوح في الصورة وأعد المحاولة.'
                    );
                }
            } catch (error) {
                console.error('OCR Error:', error);
                applyVerificationOutcome(
                    false,
                    '',
                    'مرفوض! تعذر إثبات رمز الدعوة (79UJ) تلقائياً من الصورة حالياً. أعد المحاولة بصورة أوضح أو استخدم أدوات الاختبار بالأسفل.'
                );
            } finally {
                isAnalyzingScreenshot = false;
            }
        }

        // إعادة تشغيل فحص OCR للصورة الحالية
        function retryOcrAnalysis() {
            if (isKickedOut) return;
            if (!uploadedScreenshotUrl && !currentScreenshotFile) {
                showToast('يرجى رفع لقطة شاشة أولاً.');
                return;
            }
            analyzeScreenshotWithOcr(currentScreenshotFile || uploadedScreenshotUrl);
        }

        // التحقق من صحة لقطة الشاشة وعرض المعاينة وبدء الفحص التلقائي
        function processScreenshotFile(file) {
            if (isKickedOut) return;
            const errorEl = document.getElementById('screenshot-error');
            const errorTextEl = document.getElementById('screenshot-error-text');
            const maxSizeBytes = 5 * 1024 * 1024; // 5 MB

            if (!file.type || !file.type.startsWith('image/')) {
                errorTextEl.textContent = 'يرجى اختيار ملف صورة فقط (مثل PNG أو JPG).';
                errorEl.classList.remove('hidden');
                return;
            }

            if (file.size > maxSizeBytes) {
                errorTextEl.textContent = 'حجم الصورة يتجاوز الحد المسموح به (5 ميجابايت).';
                errorEl.classList.remove('hidden');
                return;
            }

            errorEl.classList.add('hidden');

            if (uploadedScreenshotUrl) {
                URL.revokeObjectURL(uploadedScreenshotUrl);
            }

            currentScreenshotFile = file;
            uploadedScreenshotUrl = URL.createObjectURL(file);

            document.getElementById('screenshot-preview-img').src = uploadedScreenshotUrl;
            document.getElementById('screenshot-file-name').textContent = file.name;
            const sizeKB = (file.size / 1024).toFixed(1);
            document.getElementById('screenshot-file-size').textContent = sizeKB > 1024
                ? `${(file.size / (1024 * 1024)).toFixed(2)} MB`
                : `${sizeKB} KB`;

            document.getElementById('screenshot-dropzone').classList.add('hidden');
            document.getElementById('screenshot-preview-box').classList.remove('hidden');

            analyzeScreenshotWithOcr(file);
        }


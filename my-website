            const minutesBadgeEl = document.getElementById('ocr-minutes-badge');
            const enforcementActions = document.getElementById('ocr-enforcement-actions');

            progressWrapper.classList.add('hidden');
            feedbackBox.classList.remove('hidden');

            if (extractedText && extractedText.trim().length > 0) {
                extractedWrapper.classList.remove('hidden');
                extractedTextEl.textContent = extractedText.trim();
            } else {
                extractedWrapper.classList.add('hidden');
            }

            if (isVerified) {
                headlineEl.className = 'flex items-center gap-1.5 text-emerald-400 text-xs font-bold';
                headlineEl.innerHTML = `<i data-lucide="shield-check" class="w-4 h-4 shrink-0"></i><span>تم التحقق الصارم: تم إثبات الرمز 79UJ</span>`;

                feedbackBox.className = 'rounded-xl p-3 text-xs font-tajawal border border-emerald-500/40 bg-emerald-950/25 text-emerald-200 space-y-2';
                feedbackMsg.textContent = reasonNote || (hasMinutesProof
                    ? 'ممتاز! تم تأكيد رمز الدعوة (79UJ) وظهور مؤشر الدقائق/المكافأة في لقطة الشاشة، وتم اعتماد المهمة الأولى.'
                    : 'تم تأكيد وجود رمز الدعوة (79UJ) بوضوح في لقطة الشاشة وتم اعتماد المهمة الأولى.');

                minutesBadgeEl.classList.toggle('hidden', !hasMinutesProof);
                matchBadgeEl.textContent = '79UJ: مؤكد';
                matchBadgeEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300';
                enforcementActions.classList.add('hidden');

                setTaskOnePendingState(
                    'مكتمل (الرمز 79UJ مؤكد)',
                    'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40',
                    true
                );

                lucide.createIcons();
                showToast('تم إثبات رمز الدعوة 79UJ بنجاح!');
                return;
            }

            // حالة الرفض الصارم: احتساب محاولة فاشلة / مخالفة
            failedVerificationAttempts += 1;
            updateAttemptsBadge();
            minutesBadgeEl.classList.add('hidden');

            const remainingAttempts = MAX_FAILED_ATTEMPTS - failedVerificationAttempts;

            // إذا تجاوز أو بلغ الحد الأقصى للمحاولات الفاشلة يتم إخراجه فوراً من الجلسة
            if (failedVerificationAttempts >= MAX_FAILED_ATTEMPTS) {
                kickUserOut(
                    `تم إخراجك من الجلسة بعد ${MAX_FAILED_ATTEMPTS} محاولات فاشلة لعدم إثبات كتابة رمز الدعوة (79UJ) أو حصولك على الدقائق بعد إدخاله في تطبيق CafeGo.`
                );
                return;
            }

            // إجباره على الإعادة مع رسالة صارمة توضح عدم كتابة الرمز أو عدم إثبات الدقائق
            const strictRejectionMessage = reasonNote ||
                `مرفوض! النظام صارم ولم يجد أنك كتبت رمز الدعوة (79UJ) أو أثبتّ ربح الدقائق بعده. يجب عليك إعادة رفع لقطة شاشة حقيقية وواضحة تُظهر الرمز 79UJ (المتبقي لك ${remainingAttempts} محاولة فقط قبل الإخراج).`;

            headlineEl.className = 'flex items-center gap-1.5 text-red-400 text-xs font-bold';
            headlineEl.innerHTML = `<i data-lucide="x-circle" class="w-4 h-4 shrink-0"></i><span>مرفوض: لم يتم إثبات الرمز 79UJ (إعادة مطلوبة)</span>`;

            feedbackBox.className = 'rounded-xl p-3 text-xs font-tajawal border border-red-500/40 bg-red-950/25 text-red-200 space-y-2.5';
            feedbackMsg.textContent = `${strictRejectionMessage} [محاولة فاشلة ${failedVerificationAttempts} من ${MAX_FAILED_ATTEMPTS}]`;

            matchBadgeEl.textContent = '79UJ: غير موجود';
            matchBadgeEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-red-500/20 text-red-300';
            enforcementActions.classList.remove('hidden');

            const card1 = document.getElementById('task-card-1');
            card1.classList.remove('border-emerald-500/40', 'bg-emerald-950/10', 'border-gaming-border');
            card1.classList.add('border-red-500/40', 'bg-red-950/10');

            const badge = document.getElementById('screenshot-status-badge');
            badge.textContent = `مرفوض - أعد المحاولة (${failedVerificationAttempts}/${MAX_FAILED_ATTEMPTS})`;
            badge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-red-500/20 text-red-300 border border-red-500/40';

            completedTasks[1] = false;
            updateTasksProgress();

            lucide.createIcons();
            showToast(`لم يتم العثور على الرمز 79UJ! أعد المحاولة (${failedVerificationAttempts}/${MAX_FAILED_ATTEMPTS}).`);
        }

